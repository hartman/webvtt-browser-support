STYLE
::cue { font-size: 28px; color: white; }

STYLE
/* baseline: original bare form on plain text (no element wrapping) */
::cue(:past) { color: lime; }
::cue(:future) { color: red; }

STYLE
/* tag-qualified pseudo on <c> wrapped text */
::cue(c.testc:past) { color: lime; }
::cue(c.testc:future) { color: red; }

STYLE
/* tag-qualified pseudo on <v> wrapped text */
::cue(v.testv:past) { color: lime; }
::cue(v.testv:future) { color: red; }

STYLE
/* explicit universal selector + pseudo, per spec grammar ::cue(*:past) */
::cue(*.teststar:past) { color: orange; }
::cue(*.teststar:future) { color: blue; }

